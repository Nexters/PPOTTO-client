{
  "expo": {
    "name": "뽀또",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ppotto-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/ppotto-icon.png",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.ppotto.mobile",
      "buildNumber": "1"
    },
    "android": {
      "icon": "./assets/ppotto-icon.png",
      "package": "com.ppotto.mobile",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/ppotto-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": "뽀또는 보드에 사용할 최근 사진을 불러오고 선택하기 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": "완성된 리캡 이미지를 사진 보관함에 저장합니다.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "react-native-share",
        {
          "ios": ["instagram-stories"],
          "android": ["com.instagram.android"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          }
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "8434de838d07c6355f3d848b5f5e8b91",
          "overrideKakaoSDKVersion": "2.22.0",
          "kotlinVersion": "2.0.21"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8434de838d07c6355f3d848b5f5e8b91",
          "android": {
            "forwardKakaoLinkIntentFilterToMainActivity": true
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.ppotto.co.kr/",
          "organization": "ppotto",
          "project": "ppotto-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
